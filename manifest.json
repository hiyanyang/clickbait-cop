{
  "manifest_version": 3,
  "name": "封面避雷针",
  "version": "1.3.2",
  "description": "把 YouTube、B 站、抖音的封面换成视频里真实的画面，不再被夸张封面和 AI 生成的假封面骗进去。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.douyin.com/*",
    "https://*.hdslb.com/*",
    "https://*.douyinpic.com/*",
    "https://*.byteimg.com/*",
    "https://*.ibyteimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.douyin.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/util.js",
        "content/bilibili.js",
        "content/douyin.js",
        "content/youtube.js",
        "content/engine.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "封面避雷针",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}
